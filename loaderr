local HUBS = {
	[9908641400] = "colethelastcat-cloud/FF3/refs/heads/main/ff3",
	[6022371481] = "colethelastcat-cloud/Spelling-Bee/refs/heads/main/sb",
	[4730278139] = "colethelastcat-cloud/ub/refs/heads/main/untilted%20boxing",
	[6969237940] = "colethelastcat-cloud/ub/refs/heads/main/untilted%20boxing",
	[4777817887] = "colethelastcat-cloud/Bladeball/refs/heads/main/BB",
	[10539411000] = "colethelastcat-cloud/CATL/refs/heads/main/CATL",
}

local path = HUBS[game.GameId]
if not path then
	return warn(("[Blank Hub] nothing for this game (place %d)"):format(game.PlaceId))
end

local ok, src = pcall(game.HttpGet, game, "https://raw.githubusercontent.com/" .. path .. "?t=" .. tick())
if not ok then return warn("[Blank Hub] download failed: " .. tostring(src)) end

local fn, err = loadstring(src)
if not fn then return warn("[Blank Hub] compile error: " .. tostring(err)) end

local ran, runErr = pcall(fn)
if not ran then warn("[Blank Hub] runtime error: " .. tostring(runErr)) end
